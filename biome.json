{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/dist",
      "!**/dist_crx",
      "!**/coverage",
      "!**/doc",
      "!**/docs",
      "!**/node_modules",
      "!**/.vscode",
      "!**/pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "preset": "none"
      },
      "complexity": {
        "preset": "none"
      },
      "nursery": {
        "preset": "none"
      },
      "a11y": {
        "preset": "recommended"
      },
      "performance": {
        "preset": "recommended"
      },
      "suspicious": {
        "preset": "recommended",
        "noExplicitAny": "off",
        "noExportsInTest": "off",
        "noTsIgnore": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/ui/common/useAsyncEffect.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "useExhaustiveDependencies": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/ui/common/SearchInput/SearchInput.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noStaticElementInteractions": "off",
            "useKeyWithClickEvents": "off"
          }
        }
      }
    }
  ]
}
