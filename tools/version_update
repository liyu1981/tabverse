#!/usr/bin/env node

// Bumps the two places the version is written down (adr/0034): package.json is
// what the manifest is generated from, and src/global.ts is what the About
// panel shows. The tag names it as well, and the release workflow refuses to
// build unless all three agree - so this is the only thing to run, and the one
// commit it makes is what gets tagged.
//
// This used to go through replace-in-file. Two anchored replacements over two
// known files do not need a glob engine (nor the vulnerable minimatch that
// replace-in-file's glob chain resolved to), so they are done here with `fs`.

const { readFileSync, writeFileSync } = require('node:fs');
const path = require('node:path');

const version = process.argv[2];
if (!version || !/^[0-9]+\.[0-9]+\.[0-9]+$/.test(version)) {
  console.error(
    'usage: version_update <version>, version should be [0-9].[0-9].[0-9]',
  );
  process.exit(1);
}

const root = path.resolve(__dirname, '..');

const edits = [
  {
    file: 'src/global.ts',
    // the About panel's version; the quotes and the leading "v" are part of it
    from: /export const TABSPACE_VERSION = 'v[0-9]+\.[0-9]+\.[0-9]+';/,
    to: `export const TABSPACE_VERSION = 'v${version}';`,
  },
  {
    file: 'package.json',
    // the version the manifest is generated from
    from: /"version": "[0-9]+\.[0-9]+\.[0-9]+",/,
    to: `"version": "${version}",`,
  },
];

let changed = 0;
for (const edit of edits) {
  const file = path.join(root, edit.file);
  const before = readFileSync(file, 'utf8');
  const after = before.replace(edit.from, edit.to);
  if (after === before) {
    // not an error: running it twice with the same version is a no-op, and the
    // release workflow's version check is what notices a real disagreement
    console.log(`${edit.file}: already ${version}`);
    continue;
  }
  writeFileSync(file, after);
  console.log(`${edit.file}: version is now ${version}`);
  changed += 1;
}

if (changed === 0) {
  console.log(`nothing to do: ${version} was already written down`);
}
