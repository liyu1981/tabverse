# tabversed - example settings file
#
# Copy this next to the binary and edit it:
#
#     cp .env.example .env      # then: chmod 600 .env (it holds secrets)
#
# The server reads `.env` from its working directory at startup, before it
# reads the process environment. Two rules to know:
#
#   1. THE ENVIRONMENT WINS. A variable that is already set is never
#      overwritten by this file. So systemd's EnvironmentFile, `docker run
#      --env-file` and `TABVERSED_DB=/tmp/x.db ./tabversed` all still override
#      what is written here. Use the file for the settings, the environment for
#      the one-off overrides.
#   2. To read a file from somewhere else, name it:
#      TABVERSED_ENV_FILE=/etc/tabversed/settings.env
#      A path given that way and not readable is a startup error - the server
#      would rather refuse to start than quietly run on its defaults.
#
# Format: one KEY=VALUE per line, `#` comments, optional `export` and optional
# quotes around a value. There is no `${VAR}` interpolation and no command
# substitution. An empty value means "use the default", so `KEY=` is *not* a way
# to switch something off - write `KEY=false` or `KEY=0`.
# A line that is not KEY=VALUE stops the server, with the line number.
#
# `.env` is git-ignored. Never commit the copy with your real values in it.


# ---------------------------------------------------------------------------
# A production deployment, start to finish
# ---------------------------------------------------------------------------
#
#   1. Give it a hostname and TLS. The console, the sign-in links and the
#      Google callback are all built from TABVERSED_PUBLIC_URL, and session
#      cookies need https (they are dropped otherwise, which looks like a
#      successful sign-in that lands signed out).
#   2. Register the redirect URI with the provider:
#         https://<your-host>/auth/google/callback
#   3. Fill in the block below, then start the server.
#   4. Register with TABVERSED_ADMIN_EMAIL - that first registration is the
#      operator, and nothing else promotes anybody.
#   5. Mint a pairing code in the console and paste it, with this server's URL,
#      into the extension's sync dialog.
#
# Run order matters: until an operator account exists, the pairing/bootstrap
# endpoint is open to whoever reaches it first. Either keep TABVERSED_ADDR on
# loopback (or firewalled) while you register, or accept that race.


# ---------------------------------------------------------------------------
# Where it listens, and where its data is
# ---------------------------------------------------------------------------

# The bind address. Behind a reverse proxy this should be loopback: the proxy
# is the public face, and this keeps the bootstrap endpoint off the network.
# The server warns in its log when it listens on anything else.
#TABVERSED_ADDR=127.0.0.1:8223

# The SQLite file. Keep the directory on a persistent volume: the database
# holds the accounts, their records and - unless you set a secret below - the
# key that signs sessions.
#TABVERSED_DB=/var/lib/tabversed/tabversed.db

# The address people reach the console on. No trailing slash. Everything the
# server links to is built from this, including Google's redirect URI.
#TABVERSED_PUBLIC_URL=https://tabs.example.com

# WebSocket Origin allow list for /api/v1/sync/stream (comma separated).
# Unset means any origin may connect; the bearer token is still required. Set it
# in production.
#TABVERSED_WS_ORIGINS=https://tabs.example.com


# ---------------------------------------------------------------------------
# Accounts and who runs the server
# ---------------------------------------------------------------------------

# The address whose FIRST registration becomes the operator (adr/0013). No
# token, no code, nothing to copy out of a log. Once an operator exists this
# grants nothing, so leaving it set cannot become a stale privilege.
#
# If the account already exists when you set this, the next start promotes it -
# that is the upgrade path from a deployment registered before the rule.
#TABVERSED_ADMIN_EMAIL=you@example.com

# Signs the console's session cookies. Generate one with:
#     openssl rand -base64 48
# Leave it unset and the server generates one on first boot and keeps it in the
# database, which works - but then a restored backup changes every session, and
# the secret is in the same file as the data it protects.
#TABVERSED_AUTH_SECRET=

# Secure attribute on the session cookie. Keep true. The server turns it off by
# itself for an http:// public URL and says so loudly in the log.
#TABVERSED_SECURE_COOKIES=true

# Link a social login to an existing account with the same verified address.
# Turn it off if you do not fully trust the provider's address claim: such a
# login is then refused rather than merged.
#TABVERSED_LINK_BY_EMAIL=true

# Refuse a session for an account whose address has not been proven. The
# passwordless email link proves it on every login. If you sign in only with a
# provider that does not hand the server an address, this is the setting that
# will refuse you: set it false and promote the operator once by hand
# (sqlite3 tabversed.db "UPDATE users SET role='admin' WHERE email='<you>'").
#TABVERSED_REQUIRE_EMAIL_VERIFICATION=true


# ---------------------------------------------------------------------------
# Google sign-in
# ---------------------------------------------------------------------------
#
# In the Google Cloud console: OAuth consent screen (add your domain) ->
# Credentials -> OAuth client ID -> Application type: Web application ->
# Authorized redirect URI:
#
#     https://<your-host>/auth/google/callback
#
# Then put the client id and secret here. Both or neither - the server refuses
# to start on half a pair. The "Continue with Google" button appears on the
# console's sign-in screen only once the id is set.
#
# For a private deployment, leaving the consent screen in "Testing" and adding
# each person as a test user is the cheapest route; Google then caps it at 100
# test users.
#
#TABVERSED_GOOGLE_CLIENT_ID=
#TABVERSED_GOOGLE_CLIENT_SECRET=

# GitHub, same shape: an OAuth app with the callback
# https://<your-host>/auth/github/callback
#TABVERSED_GITHUB_CLIENT_ID=
#TABVERSED_GITHUB_CLIENT_SECRET=


# ---------------------------------------------------------------------------
# The passwordless email link
# ---------------------------------------------------------------------------
#
# You need this only if people sign in with a link instead of (or as well as) a
# provider. With no SMTP host the link is printed to the server's log, which is
# what a LAN deployment wants and is not what a public one does.
#
#TABVERSED_SMTP_HOST=smtp.example.com
#TABVERSED_SMTP_PORT=587
#TABVERSED_SMTP_USER=
#TABVERSED_SMTP_PASS=
#TABVERSED_SMTP_FROM=tabs@example.com


# ---------------------------------------------------------------------------
# Limits and housekeeping
# ---------------------------------------------------------------------------

# Prune `session` records older than this many days. That entity only exists
# for clients older than adr/0006 - current extensions do not write it - so this
# is about legacy data. 0 keeps it forever.
#TABVERSED_RETENTION_DAYS=14

# How long a device must go without a successful authentication before an
# operator may archive it (adr/0011). 0 disables the check, leaving "has no
# usable token" as the only rule.
#TABVERSED_DEVICE_INACTIVE_DAYS=30

#TABVERSED_MAX_RECORD_BYTES=1048576
#TABVERSED_SYNC_BATCH_LIMIT=500
#TABVERSED_SEARCH_LIMIT=50

# The auth library's fake OAuth provider, for local development. Refused unless
# the address is loopback; never set this in production.
#TABVERSED_DEV_MODE=false
