.DS_Store
# The extension's bundle, at the root only. A nested `dist` is either listed
# here (server/dist) or the console's, which is generated but whose directory
# must exist for go:embed to compile (see the note further down).
/dist/
node_modules/
.cache/
.parcel-cache/
coverage/
dist_crx/
*/.watchman-cookie*
server/bin/
server/dist/
# air's scratch: the previous binary while a new one is being built, and the
# build-errors log it leaves behind (server/.air.toml)
server/tmp/
server/build-errors.log
# the SQLite file of a local dev run (only the server's own data dir, never
# src/data/ which is source)
server/data/
# The console's build output (adr/0018): generated by `pnpm run ui:build`,
# embedded by server/internal/webui, and never committed. The .gitkeep is the
# one tracked file in it and it is deliberately empty: `//go:embed all:dist`
# needs the directory to exist for `go build` to compile on a fresh clone (vite
# empties the directory on every build, so `ui:build` puts the file back), and
# server/internal/webui's test fails with the command to run when the bundle is
# missing. The console's shape is described in server/ui and adr/0018.
server/internal/webui/dist/*
!server/internal/webui/dist/.gitkeep
# The site embedded *outside* /console (adr/0024): the built documentation
# site when the binary was built with `officialserver=1`, and nothing else
# otherwise. Same deal as the console's dist - generated by tools/embedsite.sh,
# never committed, and the tracked .gitkeep is what keeps `//go:embed all:docs`
# compiling on a fresh clone. The redirect page it falls back to
# (server/internal/webui/home/index.html) is tracked.
server/internal/webui/docs/*
!server/internal/webui/docs/.gitkeep
# a deployment's real settings, which hold two secrets. The template next to it
# is the tracked one.
server/.env
