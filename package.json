{
  "name": "tabverse",
  "version": "0.6.0",
  "description": "Tabverse is an opinionated tab manager for Chrome browser.",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:ts6": "tsc6 --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "build": "vite build",
    "develop": "vite build --watch --mode development",
    "build-doc": "./tools/builddoc.sh",
    "build-crx": "./tools/buildcrx.sh",
    "ui:build": "vite build --config server/ui/vite.config.mts && node -e \"require('fs').writeFileSync('server/internal/webui/dist/.gitkeep','')\"",
    "ui:dev": "vite --config server/ui/vite.config.mts",
    "server:dev": "cd server && air",
    "server:run": "pnpm run ui:build && cd server && go run ./cmd/tabversed serve",
    "server:build": "pnpm run ui:build && cd server && CGO_ENABLED=0 go build -trimpath -o bin/tabversed ./cmd/tabversed",
    "server:test": "pnpm run ui:build && cd server && go test ./...",
    "server:test-race": "pnpm run ui:build && cd server && go test -race ./...",
    "server:vet": "pnpm run ui:build && cd server && go vet ./...",
    "server:fmt": "cd server && gofmt -l -w .",
    "server:fmt:check": "cd server && gofmt -l .",
    "server:cross": "pnpm run ui:build && cd server && mkdir -p dist && for t in linux/amd64 linux/arm64 darwin/amd64 darwin/arm64 windows/amd64; do os=${t%/*}; arch=${t#*/}; ext=\"\"; [ \"$os\" = windows ] && ext=\".exe\"; CGO_ENABLED=0 GOOS=$os GOARCH=$arch go build -trimpath -o dist/tabversed-$os-$arch$ext ./cmd/tabversed || exit 1; done",
    "server:docker": "cd server && docker build -t tabversed:dev -t tabversed:latest .",
    "format:check": "biome format .",
    "format:write": "biome format --write .",
    "lint:check": "biome lint .",
    "lint:fix": "biome lint --write .",
    "depcheck": "depcheck"
  },
  "keywords": [],
  "author": "Yu Li",
  "license": "MIT License",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@blueprintjs/colors": "^5.1.16",
    "@blueprintjs/core": "^6.20.0",
    "@blueprintjs/icons": "^6.14.1",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/chrome": "^0.3.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.6.3",
    "@types/pubsub-js": "^1.8.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "depcheck": "^1.4.7",
    "dexie": "^4.4.6",
    "effector": "^23.4.4",
    "effector-react": "^23.3.0",
    "fake-indexeddb": "^6.2.5",
    "immer": "^11.1.18",
    "immutable": "~5.1.9",
    "lodash": "^4.18.1",
    "nanoid": "^6.0.1",
    "normalize.css": "^8.0.1",
    "pubsub-js": "^1.9.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "replace-in-file": "^9.0.0",
    "sass": "^1.105.0",
    "simplebar-react": "^3.3.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
