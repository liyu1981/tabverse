{
  "name": "tabverse",
  "version": "0.5.0",
  "description": "Tabverse is an opinionated tab manager for Chrome browser.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "build": "vite build",
    "develop": "vite build --watch --mode development",
    "build-doc": "./tools/builddoc.sh",
    "build-crx": "./tools/buildcrx.sh",
    "server:dev": "cd server && go run ./cmd/tabversed",
    "server:build": "cd server && CGO_ENABLED=0 go build -trimpath -o bin/tabversed ./cmd/tabversed",
    "server:test": "cd server && go test ./...",
    "server:test-race": "cd server && go test -race ./...",
    "server:vet": "cd server && go vet ./...",
    "server:fmt": "cd server && gofmt -l -w .",
    "server:fmt:check": "cd server && gofmt -l .",
    "server:cross": "cd server && mkdir -p dist && for t in linux/amd64 linux/arm64 darwin/amd64 darwin/arm64 windows/amd64; do os=${t%/*}; arch=${t#*/}; ext=\"\"; [ \"$os\" = windows ] && ext=\".exe\"; CGO_ENABLED=0 GOOS=$os GOARCH=$arch go build -trimpath -o dist/tabversed-$os-$arch$ext ./cmd/tabversed || exit 1; done",
    "server:docker": "cd server && docker build -t tabversed:dev -t tabversed:latest .",
    "format:check": "biome format .",
    "format:write": "biome format --write .",
    "lint:check": "eslint .",
    "lint:fix": "eslint --fix .",
    "depcheck": "depcheck"
  },
  "keywords": [],
  "author": "Yu Li",
  "license": "MIT License",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@blueprintjs/colors": "^5.1.16",
    "@blueprintjs/core": "^6.20.0",
    "@blueprintjs/icons": "^6.14.1",
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-free": "^6.1.1",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/chrome": "^0.3.0",
    "@types/lodash": "^4.14.182",
    "@types/node": "^24.0.0",
    "@types/pubsub-js": "^1.8.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "classnames": "^2.5.1",
    "clsx": "^1.2.1",
    "date-fns": "^4.4.0",
    "depcheck": "^1.4.3",
    "dexie": "^4.4.6",
    "effector": "^23.4.4",
    "effector-react": "^23.3.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fake-indexeddb": "^3.1.7",
    "globals": "^16.0.0",
    "immer": "^9.0.15",
    "immutable": "~3.7.4",
    "lodash": "^4.17.21",
    "nanoid": "^3.1.31",
    "normalize.css": "^8.0.1",
    "pubsub-js": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "replace-in-file": "^6.3.5",
    "sass": "^1.105.0",
    "simplebar-react": "^3.3.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
